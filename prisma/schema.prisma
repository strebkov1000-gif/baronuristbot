generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AvailableSlot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  bookingId String?
  createdBy BigInt
  createdAt DateTime @default(now())

  @@unique([date, startTime])
  @@index([date])
  @@index([isBooked])
  @@map("available_slots")
}

model Booking {
  id                   String         @id @default(cuid())
  userId               String
  serviceId            String
  startTime            DateTime
  endTime              DateTime
  status               booking_status @default(PENDING)
  paymentStatus        payment_status @default(PENDING)
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  paymentType          payment_type   @default(PREPAYMENT)
  prepaidAmountUsd     Int            @default(0)
  remainingAmountUsd   Int            @default(0)
  totalPriceUsd        Int            @default(0)
  remainingPaymentMemo String?
  service              Service        @relation(fields: [serviceId], references: [id])
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment              Payment?

  @@unique([userId, startTime])
  @@index([paymentStatus])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([userId])
  @@map("bookings")
}

model Payment {
  id                 String            @id @default(cuid())
  bookingId          String            @unique
  userId             String
  amountUsd          Int
  amountTon          String?
  recipientAddress   String
  senderAddress      String?
  status             payment_status    @default(PENDING)
  tonTransactionHash String?           @unique
  tonTransactionLt   String?
  initiatedAt        DateTime          @default(now())
  completedAt        DateTime?
  expiresAt          DateTime
  memoMatchStatus    memo_match_status @default(AWAITING)
  paymentMemo        String?           @unique
  promoInfo          String?
  receivedAmountUsd  Int?
  booking            Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentMemo])
  @@index([status])
  @@index([tonTransactionHash])
  @@index([userId])
  @@map("payments")
}

model PromoCodeUsage {
  id             String    @id @default(cuid())
  promoCodeId    String
  userId         String
  bookingId      String
  discountAmount Int
  createdAt      DateTime  @default(now())
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id])

  @@unique([promoCodeId, userId])
  @@index([userId])
  @@map("promo_code_usages")
}

model PromoCode {
  id              String           @id @default(cuid())
  code            String           @unique
  discountPercent Int
  expiresAt       DateTime
  serviceId       String?
  isActive        Boolean          @default(true)
  createdBy       BigInt
  createdAt       DateTime         @default(now())
  usages          PromoCodeUsage[]

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

model Reservation {
  id        String             @id @default(cuid())
  userId    String
  serviceId String
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  status    reservation_status @default(ACTIVE)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([startTime])
  @@index([status])
  @@index([userId])
  @@map("reservations")
}

model Service {
  id              String    @id @default(cuid())
  serviceId       String    @unique
  name            String
  nameEn          String?
  description     String
  stages          String
  priceUsd        Int
  durationMinutes Int
  requiresBooking Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]

  @@index([serviceId])
  @@map("services")
}

model UserSurvey {
  id                 String        @id @default(cuid())
  userId             String
  serviceId          String
  bookingId          String?
  fullName           String
  phoneNumber        String
  problemDescription String
  voiceMessageFileId String?
  materialsLink      String?
  status             survey_status @default(PENDING)
  processedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("user_surveys")
}

model User {
  id            String        @id @default(cuid())
  telegramId    BigInt        @unique
  username      String?
  firstName     String?
  lastName      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  referralBonus Int           @default(0)
  referralCode  String?       @unique
  referredById  String?
  bookings      Booking[]
  payments      Payment[]
  reservations  Reservation[]
  surveys       UserSurvey[]
  referrer      User?         @relation("UserReferrals", fields: [referredById], references: [id])
  referrals     User[]        @relation("UserReferrals")

  @@index([referralCode])
  @@index([telegramId])
  @@map("users")
}

enum booking_status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum memo_match_status {
  AWAITING
  MATCHED
  MANUAL_REVIEW
  INSUFFICIENT
}

enum payment_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum payment_type {
  FULL
  PREPAYMENT
}

enum reservation_status {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum survey_status {
  PENDING
  PROCESSING
  COMPLETED
}
