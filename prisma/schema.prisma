generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model available_slots {
  id        String   @id
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  bookingId String?
  createdBy BigInt
  createdAt DateTime @default(now())

  @@unique([date, startTime])
  @@index([date])
  @@index([isBooked])
}

model bookings {
  id                   String         @id
  userId               String
  serviceId            String
  startTime            DateTime
  endTime              DateTime
  status               booking_status @default(PENDING)
  paymentStatus        payment_status @default(PENDING)
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime
  paymentType          payment_type   @default(PREPAYMENT)
  prepaidAmountUsd     Int            @default(0)
  remainingAmountUsd   Int            @default(0)
  totalPriceUsd        Int            @default(0)
  remainingPaymentMemo String?
  services             services       @relation(fields: [serviceId], references: [id])
  users                users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments             payments?

  @@unique([userId, startTime])
  @@index([paymentStatus])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([userId])
}

model payments {
  id                 String            @id
  bookingId          String            @unique
  userId             String
  amountUsd          Int
  amountTon          String?
  recipientAddress   String
  senderAddress      String?
  status             payment_status    @default(PENDING)
  tonTransactionHash String?           @unique
  tonTransactionLt   String?
  initiatedAt        DateTime          @default(now())
  completedAt        DateTime?
  expiresAt          DateTime
  memoMatchStatus    memo_match_status @default(AWAITING)
  paymentMemo        String?           @unique
  promoInfo          String?
  receivedAmountUsd  Int?
  bookings           bookings          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  users              users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentMemo])
  @@index([status])
  @@index([tonTransactionHash])
  @@index([userId])
}

model promo_code_usages {
  id             String      @id
  promoCodeId    String
  userId         String
  bookingId      String
  discountAmount Int
  createdAt      DateTime    @default(now())
  promo_codes    promo_codes @relation(fields: [promoCodeId], references: [id])

  @@unique([promoCodeId, userId])
  @@index([userId])
}

model promo_codes {
  id                String              @id
  code              String              @unique
  discountPercent   Int
  expiresAt         DateTime
  serviceId         String?
  isActive          Boolean             @default(true)
  createdBy         BigInt
  createdAt         DateTime            @default(now())
  promo_code_usages promo_code_usages[]

  @@index([code])
  @@index([isActive])
}

model reservations {
  id        String             @id
  userId    String
  serviceId String
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  status    reservation_status @default(ACTIVE)
  createdAt DateTime           @default(now())
  users     users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([startTime])
  @@index([status])
  @@index([userId])
}

model services {
  id              String     @id
  serviceId       String     @unique
  name            String
  nameEn          String?
  description     String
  stages          String
  priceUsd        Int
  durationMinutes Int
  requiresBooking Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  bookings        bookings[]

  @@index([serviceId])
}

model user_surveys {
  id                 String        @id
  userId             String
  serviceId          String
  bookingId          String?
  fullName           String
  phoneNumber        String
  problemDescription String
  voiceMessageFileId String?
  materialsLink      String?
  status             survey_status @default(PENDING)
  processedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  users              users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model users {
  id            String         @id
  telegramId    BigInt         @unique
  username      String?
  firstName     String?
  lastName      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  referralBonus Int            @default(0)
  referralCode  String?        @unique
  referredById  String?
  bookings      bookings[]
  payments      payments[]
  reservations  reservations[]
  user_surveys  user_surveys[]
  users         users?         @relation("usersTousers", fields: [referredById], references: [id])
  other_users   users[]        @relation("usersTousers")

  @@index([referralCode])
  @@index([telegramId])
}

enum booking_status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum memo_match_status {
  AWAITING
  MATCHED
  MANUAL_REVIEW
  INSUFFICIENT
}

enum payment_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum payment_type {
  FULL
  PREPAYMENT
}

enum reservation_status {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum survey_status {
  PENDING
  PROCESSING
  COMPLETED
}
