# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pravo_xii_bot?schema=public

# TON Blockchain Configuration
TON_WALLET_ADDRESS=your_ton_wallet_address
TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# Для тестнета используйте: https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=

# WebApp Configuration
WEBAPP_URL=https://yourdomain.com
PORT=3000

# Manager Telegram
MANAGER_USERNAME=your_manager_username

# Timezone
TZ=Europe/Moscow

# Environment
NODE_ENV=production
